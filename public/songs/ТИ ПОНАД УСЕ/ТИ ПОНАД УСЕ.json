[
  {
    "word": "Могутній правитель і нездоланний Ти,",
    "start": 20.18,
    "end": 26.68
  },
  {
    "word": "Співає творіння: «Бог з нами назавжди!»",
    "start": 29.5,
    "end": 35.9
  },
  {
    "word": "Бо царство Твоє вже скоро прийде",
