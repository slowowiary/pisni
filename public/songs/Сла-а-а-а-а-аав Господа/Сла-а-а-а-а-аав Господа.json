  },
  {
    "word": "Слав, душа, Господа!",
    "start": 52.46,
    "end": 56.38
  },
  {
    "word": "Хвалю, коли знаю,",
    "start": 56.38,
    "end": 59.44
  },
  {
    "word": "коли сумніваюсь,",
    "start": 60.46,
    "end": 62.84
  },
  {
    "word": "Отцю довіряю",
    "start": 64.78,
    "end": 67.12
  },
  {
    "word": "і мир в серці маю",
    "start": 67.12,
    "end": 70.1
  },
  {
    "word": "Хвала – моя зброя",
    "start": 71.98,
    "end": 74.74
  },
  {
    "word": "і істини Слово,",
    "start": 74.74,
    "end": 77.68
  },
  {
    "word": "що знищити зможе",
    "start": 79.3,
    "end": 82.26
  },
  {
    "word": "стіни Єрихону.",
    "start": 82.26,
    "end": 85.16
  },
  {
    "word": "Я кожної миті буду хвалити!",
