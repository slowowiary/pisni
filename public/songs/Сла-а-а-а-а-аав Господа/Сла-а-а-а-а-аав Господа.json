[
  {
    "word": "Прославлю в долині і на вершині",
    "start": 8.0,
    "end": 13.31
  },
  {
    "word": "коли маю все – коли безсилий",
    "start": 15.31,
    "end": 20.62
  },
  {
    "word": "Прославлю самотнім і разом з народом",
    "start": 23.62,
