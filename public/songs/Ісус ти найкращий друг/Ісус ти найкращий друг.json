[
  {
    "text": "Ісус, Ти – найкращий Друг",
    "start": 14.46,
    "end": 17.6
  },
  {
    "text": "В час, коли моє серце плаче.",
    "start": 18.6,
    "end": 21.76
  },
  {
    "text": "Я до Тебе в молитві йду,",
    "start": 22.58,
    "end": 25.46
  },
  {
    "text": "Ти поможеш мені, мій Пастир.",
    "start": 26.72,
    "end": 29.98
  },
  {
    "text": "Для душі мій спокій в Тобі,",
    "start": 30.5,
    "end": 33.92
  },
  {
    "text": "Ти – відрада моя, Спаситель.",
    "start": 34.36,
    "end": 37.68
  },
  {
    "text": "Підкріпляєш у боротьбі, Вірний Друг",
    "start": 37.98,
    "end": 43.51
  },
  {
    "text": "і душі Втішитель.",
    "start": 39.82,
    "end": 45.56
  },
  {
    "text": "Я любов'ю Твоєю живу,",
    "start": 45.56,
    "end": 50.1
  },
  {
    "text": "І вона моє серце гріє.",
    "start": 50.6,
    "end": 53.5
  },
  {
    "text": "Щиро, Спасе, Тебе я люблю,",
    "start": 53.84,
    "end": 57.04
  },
  {
    "text": "І ніхто вже Тебе не замінить.",
    "start": 56.06,
    "end": 61.66
  },
  {
    "text": "Я любов'ю Твоєю живу,",
    "start": 61.84,
    "end": 65.68
  },
  {
    "text": "І вона моє серце гріє.",
    "start": 66.06,
    "end": 69.1
  },
  {
    "text": "Щиро, Спасе, Тебе я люблю,",
    "start": 69.6,
    "end": 72.78
  },
  {
    "text": "І ніхто вже Тебе не замінить.",
    "start": 73.88,
    "end": 77.06
  },
  {
    "text": "Ти Один розумієш все",
    "start": 79.12,
    "end": 83.3
  },
  {
    "text": "І думки всі таємні знаєш.",
    "start": 83.78,
    "end": 90.26
  },
  {
    "text": "Ти зі мною, у кожну мить",
    "start": 86.96,
    "end": 90.26
  },
  {
    "text": "Потішаєш і підкріпляєш.",
    "start": 91.32,
    "end": 99.88
  },
  {
    "text": "Хай полине подяка Тобі",
    "start": 94.96,
    "end": 103.48
  },
  {
    "text": "За щедроти і вічну милість.",
    "start": 98.74,
    "end": 101.46
  },
  {
    "text": "Ісус, Ти – Спаситель душі,",
    "start": 109.7,
    "end": 113.68
  },
  {
    "text": "Ти і щастя моє, і радість.",
    "start": 106.46,
    "end": 109.7
  },
  {
    "text": "Я любов'ю Твоєю живу,",
    "start": 120.42,
    "end": 123.68
  },
  {
