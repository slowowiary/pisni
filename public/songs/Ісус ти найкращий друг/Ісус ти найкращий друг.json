[
  {
    "word": "Ісус, Ти – найкращий Друг",
    "start": 14.42,
    "end": 17.62
  },
  {
    "word": "В час, коли моє серце плаче.",
    "start": 18.72,
    "end": 22.56
  },
  {
    "word": "Я до Тебе в молитві йду,",
    "start": 22.56,
    "end": 26.86
  },
  {
    "word": "Ти поможеш мені, мій Пастир.",
    "start": 26.86,
    "end": 30.6
  },
  {
    "word": "Для душі мій спокій в Тобі,",
    "start": 30.6,
    "end": 34.56
  },
  {
    "word": "Ти – відрада моя, Спаситель.",
    "start": 34.56,
    "end": 37.64
  },
  {
    "word": "Підкріпляєш у боротьбі,",
    "start": 38.06,
    "end": 42.02
  },
  {
    "word": "Вірний Друг і душі Втішитель.",
    "start": 42.02,
    "end": 45.56
  },
  {
    "word": "Я любов'ю Твоєю живу,",
    "start": 46.46,
    "end": 50.04
  },
  {
    "word": "І вона моє серце гріє.",
    "start": 50.04,
    "end": 52.66
  },
  {
    "word": "Щиро, Спасе, Тебе я люблю,",
    "start": 53.96,
    "end": 57.06
  },
  {
    "word": "І ніхто вже Тебе не замінить.",
    "start": 57.06,
    "end": 61.3
  },
  {
    "word": "Я любов'ю Твоєю живу,",
    "start": 61.3,
