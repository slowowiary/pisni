  },
  {
    "word": "І вона моє серце гріє.",
    "start": 64.1,
    "end": 67.12
  },
  {
    "word": "Щиро, Спасе, Тебе я люблю,",
    "start": 69.62,
    "end": 72.1
  },
  {
    "word": "І ніхто вже Тебе не замінить.",
    "start": 72.1,
    "end": 77.3
  },
  {
    "word": "Ти Один розумієш все",
    "start": 79.14,
    "end": 83.22
  },
  {
    "word": "І думки всі таємні знаєш.",
    "start": 83.22,
    "end": 85.74
  },
  {
    "word": "Ти зі мною, у кожну мить",
    "start": 86.96,
    "end": 90.28
  },
  {
    "word": "Потішаєш і підкріпляєш.",
    "start": 91.36,
    "end": 94.52
  },
  {
    "word": "Хай полине подяка Тобі",
    "start": 94.96,
    "end": 98.32
  },
  {
    "word": "За щедроти і вічну милість.",
    "start": 98.32,
    "end": 101.8
  },
