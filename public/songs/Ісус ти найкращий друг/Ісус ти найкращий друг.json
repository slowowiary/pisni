[
  {
    "start": 14.44,
    "end": 17.62,
    "word": "Ісус, Ти – найкращий Друг"
  },
  {
    "start": 18.56,
    "end": 21.76,
    "word": "В час, коли моє серце плаче."
  },
  {
    "start": 22.58,
    "end": 25.5,
    "word": "Я до Тебе в молитві йду,"
  },
  {
    "start": 26.38,
    "end": 29.98,
    "word": "Ти поможеш мені, мій Пастир."
  },
  {
    "start": 30.56,
    "end": 34.08,
    "word": "Для душі мій спокій в Тобі,"
  },
  {
    "start": 34.56,
    "end": 37.6,
    "word": "Ти – відрада моя, Спаситель."
  },
  {
    "start": 38.0,
    "end": 42.14,
    "word": "Підкріпляєш у боротьбі,"
  },
  {
    "start": 42.14,
    "end": 46.74,
    "word": "Вірний Друг і душі Втішитель."
  },
  {
    "start": 46.74,
    "end": 50.58,
    "word": "Я любов'ю Твоєю живу,"
  },
  {
    "start": 50.58,
    "end": 53.42,
    "word": "І вона моє серце гріє."
  },
  {
    "start": 53.94,
    "end": 57.04,
    "word": "Щиро, Спасе, Тебе я люблю,"
  },
  {
    "start": 56.06,
    "end": 61.66,
    "word": "І ніхто вже Тебе не замінить."
  },
  {
    "start": 82.64,
    "end": 86.48,
    "word": "Ти Один розумієш все"
  },
  {
    "start": 86.68,
    "end": 89.44,
    "word": "І думки всі таємні знаєш."
  },
  {
    "start": 89.44,
    "end": 94.52,
    "word": "Ти зі мною, у кожну мить"
  },
  {
    "start": 94.52,
    "end": 96.96,
    "word": "Потішаєш і підкріпляєш."
  },
  {
    "start": 96.96,
    "end": 99.88,
    "word": "Хай полине подяка Тобі"
  },
  {
    "start": 99.88,
    "end": 102.48,
    "word": "За щедроти і вічну милість."
  },
  {
    "start": 102.48,
    "end": 105.64,
    "word": "Ісус, Ти – Спаситель душі,"
