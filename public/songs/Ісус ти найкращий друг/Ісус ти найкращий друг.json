[
  {
    "start": 14.56,
    "end": 17.44,
    "word": "Ісус, Ти – найкращий Друг"
  },
  {
    "start": 18.62,
    "end": 21.76,
    "word": "В час, коли моє серце плаче."
  },
  {
    "start": 22.32,
    "end": 25.2,
    "word": "Я до Тебе в молитві йду,"
  },
  {
    "start": 25.21,
    "end": 30.0,
    "word": "Ти поможеш мені, мій Пастир."
  },
  {
    "start": 30.56,
    "end": 34.14,
    "word": "Для душі мій спокій в Тобі,"
  },
  {
    "start": 34.36,
    "end": 37.5,
    "word": "Ти – відрада моя, Спаситель."
  },
  {
    "start": 38.04,
    "end": 42.0,
    "word": "Підкріпляєш у боротьбі, Вірний Друг"
  },
  {
    "start": 42.01,
    "end": 44.5,
    "word": "і душі Втішитель."
  },
  {
    "start": 46.46,
    "end": 50.06,
    "word": "Я любов'ю Твоєю живу,"
  },
  {
    "start": 50.5,
    "end": 53.44,
    "word": "І вона моє серце гріє."
  },
  {
    "start": 53.96,
    "end": 57.24,
    "word": "Щиро, Спасе, Тебе я люблю,"
  },
  {
    "start": 57.25,
    "end": 61.32,
    "word": "І ніхто вже Тебе не замінить."
  },
